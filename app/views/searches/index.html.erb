<%- title "Search" %>
<%- active_nav "search" %>

<%- title "Categories" %>
<%- active_nav "categories" %>

<section class="app-header dashboard-hero">

  <div class="app-header-copy">
    <div class="app-label">
      <%= @project.name %> · <span class="app-label-dense">Full text search</span>
    </div>
    <h1 class="app-title">Search</h1>
    <p class="app-description">
      Search across categories, codes, experiences, identities, reflections, and themes.
    </p>
  </div>
</section>

<section aria-labelledby="search" class="category-create-section">
  <div class="search-controls">
    <%= form_with model: @search, data: {turbo: true} do |f| %>
      <label class="toolbar-field search-field"><span class="toolbar-label search-label">Search categories</span>
        <%= f.text_field :query, id: "search-live", class: "app-input search-input", type: "search", autocomplete: "on", placeholder: "Search codes", aria: { describedby: "site-search-feedback" } %>
      </label>
      <%= f.submit "Search", class: "site-search-submit" %>
      <label class="category-library-checkbox search-filter"><%= f.checkbox :scope, id: "filter-response", value:"response" %>Responses</label>
      <label class="category-library-checkbox search-filter"><%= f.checkbox :scope, id: "filter-code", value:"code" %>Codes</label>
      <label class="category-library-checkbox search-filter"><%= f.checkbox :scope, id: "filter-memo", value:"memo" %>Memos</label>
      <label class="category-library-checkbox search-filter"><%= f.checkbox :scope, id: "filter-category", value:"category" %>Categories</label>
      <label class="category-library-checkbox search-filter"><%= f.checkbox :scope, id: "filter-theme", value:"theme" %>Themes</label>
    <% end %>
  </div>
  <p aria-live="polite" class="category-library-status search-result-count" id="category-library-status"><%# pluralize(@results.count, "result") %></p>
</section>

<section>
  <%= render partial: "searches/results", locals: { search: @search } %>
</section>