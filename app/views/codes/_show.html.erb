<tr class="code-browser-row" data-frequency="<%= code.frequency %>" data-name="<%= code.label %>">
  <td class="code-name-cell">
    <span class="tag"><%= code.label %></span>
  </td>
  <td class="frequency-cell"><%= code.frequency %></td>
  <td class="origins-cell">
    <div>Questions: <%= code.questions.to_sentence %></div>
    <div>Cases: <%= pluralize(code.personas, "Persona") %></div>
    <div>Dimensions: <%= code.dimensions.to_sentence %></div>
  </td>
  <td class="row-action-cell">
    <button aria-label="Assign Sample code to this category" aria-pressed="false" class="icon-button assign-code-button" title="Assign to category" type="button"><span aria-hidden="true" class="assignment-action-icon">+</span><span class="visually-hidden assignment-action-label">Assign</span></button>
    <button aria-label="Remove '<%= code.label %>' from this category" class="icon-button remove-code-button" title="Remove from category" type="button">
      <svg aria-hidden="true" class="lucide lucide-trash2-icon lucide-trash-2" fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewbox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg">
        <path d="M10 11v6"></path>
        <path d="M14 11v6"></path>
        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"></path>
        <path d="M3 6h18"></path>
        <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
      </svg>
    </button>
  </td>
</tr>
