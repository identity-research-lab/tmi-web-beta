<%= turbo_frame_tag "theme-categories" do %>
  <% if attached_categories.any? %>
    <table aria-describedby="code-assignment-feedback" class="code-data-table" id="available-codes-table">
      <caption class="visually-hidden">Project categories available for category assignment</caption>
      <thead>
        <tr>
          <th scope="col"><button class="sort-button is-sorted" data-key="name" data-table="assigned-codes-table" type="button" >Category name <span aria-hidden="true">A–Z</span></button></th>
          <th scope="col">Description</th>
          <th scope="col"><button class="sort-button" data-key="frequency" data-table="assigned-codes-table" type="button">Assigned codes <span aria-hidden="true">↕</span></button></th>
          <th scope="col"><span class="visually-hidden">Remove category assignment</span></th>
        </tr>
      </thead>
      <tbody>
        <% attached_categories.each do |category| %>
          <%= render partial: "themes/category_row", locals: { category: category, attached_categories: attached_categories } %>
        <% end %>
      </tbody>
    </table>
  <% end %>
<% end %>