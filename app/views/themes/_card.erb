<% categories_count = theme.categories.count %>
<article aria-labelledby="category-card-title-1" class="category-overview-card filterable" data-count="<%= categories_count %>" data-name="<%= theme.name %>">
  <div class="category-overview-card-content">
    <h3 class="category-overview-card-title">
      <%= theme.name %>
    </h3>
    <p class="category-overview-card-memo">
      <%= theme.description %>
    </p>
    <div class="category-workspace-footer">
      <span class="count-badge">
        <%= "#{categories_count} category".pluralize(categories_count) %> added
      </span>
    </div>
  </div>
  <div class="category-overview-card-actions">
    <%= link_to "Manage theme", theme_path(theme), class: "button apply small", target: "top" %>
  </div>
</article>
