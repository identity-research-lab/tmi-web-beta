<%= turbo_frame_tag "theme-categories-#{pane}" do %>

  <% table_id = pane == "attached" ? "assigned-codes-table" : "available-codes-table" %>
  <div aria-label="Scrollable assigned codes table" class="data-table-window assigned-table-window" role="region" tabindex="0">
    <table class="code-data-table" id="<%= table_id %>">
      <% if categories.any? %>
        <% sort_class = pane == "attached" ? "sort-button" : "sort-button search-sort-button" %>
          <thead>
            <tr>
              <% if pane == "attached" %>
                <th scope="col" class="sortable" data-sort-direction="desc" onclick="sortTable('assigned-codes-table', 0);">
                  <span class="sort-header">
                    <button class="<%= sort_class %>" data-key="name" type="button">Category name</button>
                  </span>
                </th>
                <th scope="col" class="sortable" data-sort-direction="desc" onclick="sortTable('assigned-codes-table', 1);">
                  <span class="sort-header">
                    <button class="<%= sort_class %>" data-key="frequency" type="button">Codes</button>
                  </span>
                </th>
                <th scope="col">Description</th>
                <th scope="col"><span class="visually-hidden">Add or remove category assignment</span></th>
              <% else %>
                <th scope="col" class="sortable" data-sort-direction="desc">
                    <span class="sort-header">
                      <button class="<%= sort_class %>" data-key="name" type="button" >Category name</button>
                    </span>
                </th>
                <th scope="col" class="sortable" data-sort-direction="desc">
                    <span class="sort-header">
                      <button class="<%= sort_class %>" data-key="frequency" type="button" >Codes</button>
                    </span>
                </th>
                <th scope="col">Description</th>
                <th scope="col"><span class="visually-hidden">Add or remove category assignment</span></th>
              <% end %>
            </tr>
          </thead>
          <tbody>
            <% categories.each do |category| %>
              <%= render partial: "themes/category_row", locals: { theme: theme, category: category, attached_categories: attached_categories, pane: pane } %>
            <% end %>
          </tbody>
        <% end %>
      </table>
    </div>
    
      <% if pane == "attached" %>
        <p aria-live="polite" class="search-result-count">
          <%= attached_categories.count %> assigned project categories
        </p>
      <% else %>
        <p aria-live="polite" class="search-result-count">
          <% total ||= categories.count %>
          <% if pane == "available" %>
            <span id="available-window"></span> of
          <% end %>
          <span id="available-visible-count"></span><span id="available-total-count"><%= total %></span>
        </p>
      <% end %>  
      
      <script>fireFilters();handleSearchSort();handleSearchPagination();</script>
    <% end %>