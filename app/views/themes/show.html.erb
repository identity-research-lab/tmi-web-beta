<%- title "Themes" %>
<%- active_nav "themes" %>

<section class="app-header app-header--detail">
  <div class="app-header-copy">
    <div class="app-label">
    <%= @project.name %> · <span class="app-label-dense">Theme Development</span>
    </div>
    <h1 class="app-title"><%= @theme.name %></h1>
    <p class="app-description">
      Review and revise this analytical theme, manage its attached project categories, and document how the interpretive finding is developing across the data set.
    </p>
  </div>
  <aside aria-label="Relational analysis tools" class="app-header-panel category-relational-panel">
    <div class="app-panel-title">Relational analysis</div>
    <div class="case-subtext category-cypher-row confirmable">
      <span class="category-cypher-label">Cypher:</span>
      <a href="#" id="copy-source" class="cypher-link"><%= @theme.graph_query[:query] %></a>
      <span id="confirmation" class="hidden">Copied!</span>
      <button id="copy-to-clipboard" class="copy-query-button" aria-label="Copy Cypher query" onclick="copyToClipboard('copy-source')" />
    </div>
  </aside>
</section>

<nav aria-label="Theme workspace sections" class="category-page-links">
  <span class="category-page-links-label">On this page</span>
  <a href="#assigned-categories">Review assigned categories</a>
  <a href="#explore-categories">Explore and assign categories</a>
  <a href="#memos">Researcher memos</a>
</nav>

<!-- Category assignment workspace -->
<section class="category-detail-main">
  <div class="category-primary-layout">
  <section aria-labelledby="assigned-codes-title" class="category-work-area assigned-codes-area" id="assigned-codes">
    <div class="work-area-heading">
      <div>
        <h2 id="assigned-codes-title">Assigned categories</h2>
        <p>Review, search, sort, and remove categories currently assigned to this theme.</p>
      </div>
      <span class="count-badge metric-count-badge"><span id="assigned-count"><%= @theme_categories.count %></span> assigned categories</span>
    </div>
    <%= render partial: "themes/categories", locals: { theme: @theme, categories: @theme_categories, attached_categories: @theme_categories, pane: "attached" } %>
  </section>

  <section aria-labelledby="find-codes-title" class="category-work-area code-browser-area" id="explore-codes">
    <div class="work-area-heading browser-heading">
      <div>
        <h2 id="find-codes-title">Explore, find, and assign categories</h2>
        <p>Search the full project categories collection and add relevant categories to this category.</p>
      </div>
    </div>
    <div aria-label="Search and filter all project categories" class="table-toolbar code-browser-controls search-toolbar" role="search">
      <label class="search-field">
        <span class="visually-hidden">Search all project categories</span>
        <svg aria-hidden="true" viewbox="0 0 24 24"><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 4 4"></path></svg>

        <%= form_with model: Search.new(query: "", scope: "theme"), data: {turbo: true} do |f| %>
          <label class="search-field browser-search"><span class="visually-hidden">Search categories</span>
            <%= f.text_field :query, id: "search-live", class: "app-input search-input", type: "search", autocomplete: "on", placeholder: "Search category names and descriptions" %>
            <%= f.hidden_field :scope, multiple: true, value: "category" %>
            <%= f.hidden_field :context, value: "theme-details" %>
            <%= f.hidden_field :context_id, value: @theme.id %>
          </label>
        <% end %>

      </label>
      <label class="toolbar-control category-library-checkbox search-filter"><input aria-controls="category-list" id="filter-count" type="checkbox"/>Empty</label>
      <label class="toolbar-control category-library-checkbox search-filter"><input aria-controls="category-list" id="filter-attached" type="checkbox"/>Unassigned</label>
    </div>
    <p class="visually-hidden" id="occurrences-help">Assigned codes is the number of project codes currently organized within a category.</p>

    <div aria-label="Scrollable project codes table" class="available-table-window" role="region" tabindex="0">
      <%= render partial: "themes/categories", locals: { theme: @theme, categories: @all_categories, attached_categories: @theme_categories, pane: "available" } %>
    </div>
    
    <div class="empty-state search-empty-state" id="available-codes-empty" hidden><strong>No matching project categories</strong><p>No project categories match the current search and filters.</p><button aria-controls="available-codes-table" class="button secondary small" id="clear-browser-search-filters" type="button">Clear filters</button></div>
  </section>
  <%= render partial: "memos/feed", locals: { memo: @memo, memos: @memos, css_class: "category-detail-memos" } %>
  </div>
</section>
