<%- title "Code Metrics" %>
<%- active_nav "codes" %>

<section class="app-header dashboard-hero">
  <div class="app-header-copy">
    <div class="app-label">
      <%= @project.name %> · <span class="app-label-dense">Pathways</span> · <span class="app-label-dense">Coding by Question</span>
    </div>
    <h1 class="app-title">Code Metrics</h1>
    <p class="app-description">
      Review coding patterns through either the individual case pathway or the question/response pathway while preserving the context in which codes were applied.    
    </p>
  </div>
</section>

<% if @project.active_fields.count == 0 %>
  <section class="coding-readiness-gate" data-coding-readiness-states="setup">
    <div class="app-label">Project readiness</div>
    <h2 class="workspace-title">Project data setup required</h2>
    <p class="workspace-note">Add project data and confirm the analysis schema before reviewing code metrics.</p>
    <%= link_to "Manage project data", edit_project_path(@project), class: "button apply" %>
  </section>
<% elsif @survey_items.any? %>
  <section class="metrics-scope-switcher" data-modes="question case" aria-labelledby="metrics-scope-title">
    <div>
      <div class="app-label">Metrics scope</div>
      <h2 class="workspace-title" id="metrics-scope-title">Choose how to review code occurrences</h2>
    </div>
    <div class="metrics-scope-actions" role="group" aria-label="Choose metrics scope">
      <button class="metrics-scope-button" type="button" data-mode="case">
        <span class="metrics-scope-button-title">Individual case view</span>
        <span>Review code occurrences across one participant’s responses.</span>
      </button>
      <button class="metrics-scope-button" type="button" data-mode="question">
        <span class="metrics-scope-button-title">Responses by question view</span>
        <span>Compare code occurrences across participants responding to one question.</span>
      </button>
    </div>
  </section>
  <div id="persona-mode" class="hidden">
    <%= render partial: "persona", locals: { persona: nil, personas: @personas } %>
  </div>
  <div id="question-mode" class="hidden">
    <%= render partial: "question", locals: { survey_item: nil, survey_items: @survey_items } %>
  </div>

<% end %>
