<%- title "Categories" %>
<%- active_nav "categories" %>

<section class="app-header dashboard-hero">

  <div class="app-header-copy">
    <div class="app-label">
      <%= @project.name %> · <span class="app-label-dense">Category Development</span>
    </div>
    <h1 class="app-title">Categories</h1>
    <p class="app-description">
      Create, review, revise, and remove analytical categories. Categories organize related researcher-applied codes into higher-level concepts that can later support theme development.
    </p>
  </div>
  <aside aria-label="Category status" class="app-header-panel">
   <div class="app-panel-title">
    Category Status
   </div>
   <div class="app-stats-grid">
    <div class="app-stat">
     <span class="app-stat-value">
        <%= @categories.count %>
     </span>
     <span class="app-stat-label">
    Categories
     </span>
    </div>
    <div class="app-stat">
     <span class="app-stat-value">
        <%= @code_count %>
     </span>
     <span class="app-stat-label">
    Project Codes
     </span>
    </div>
    <div class="app-stat">
     <span class="app-stat-value">
      <%= @categorized_code_count %>
     </span>
     <span class="app-stat-label">
     Codes assigned to categories
     </span>
    </div>
    <div class="app-stat">
     <span class="app-stat-value">
      <%= @uncategorized_code_count %>
     </span>
     <span class="app-stat-label">
      Codes not yet assigned
     </span>
    </div>
   </div>
  </aside>
 </section>

 <section aria-labelledby="create-category-title" class="category-create-section">

    <div class="category-create-layout category-create-layout-single">
      <div class="category-create-workspace">
      <div class="workspace-title-row category-create-intro-row">
      <div>
      <h2 class="workspace-title" id="create-category-title">
        Create a new project category
      </h2>
        <p class="workspace-note">Name and describe a category now. Add and organize codes after it has been created.</p>
      </div>
    </div>

   <%= form_with model: Category.new, format: :turbo_stream, data: { turbo_stream: true }, class: "category-create-grid", id: "create-category-form", aria: { label: "Create a new project category", describedby: "category-form-note" } do |f| %>

     <div class="category-create-fields">
       <div class="category-create-panel category-create-name">
         <%= f.label :name, "New category name", class: "app-label category-create-label", for: "new-category-name" %>
         <%= f.text_field :name, id: "new-category-name", class: "app-input category-create-input", placeholder: "Enter a category name", autocomplete: "off", required: true, aria: { describedby: "new-category-name-help new-category-name-error" } %>
   
         <p class="form-help" id="new-category-name-help">Required. Use a concise analytical name that distinguishes this category from related concepts.</p>
         <p class="form-error" data-error-for="new-category-name" hidden id="new-category-name-error">Enter a category name.</p>
       </div>
   
       <div class="category-create-panel category-create-description">
         <%= f.label :description, "Description", class: "app-label category-create-label", for: "new-category-memo" %>
         <%= f.text_area :description, id: "new-category-memo", class: "category-create-textarea", placeholder: "Describe the category and the kinds of codes it may organize.", aria: { describedby: "new-category-memo-help" } %>
   
         <p class="form-help" id="new-category-memo-help">
           Optional. Explain the category’s analytical purpose and the kinds of codes it may organize.
         </p>
       </div>
     </div>
   
     <div class="category-create-footer">
       <%= f.submit "Create new project category", class: "button apply small category-create-button" %>
     </div>
   
   <% end %>
   
   <p aria-live="polite" class="category-create-feedback form-success" id="category-create-feedback" hidden role="status" tabindex="-1"></p>
  </div>
</section>
 

<% if @categories.any? %>
  <section class="app-section bordered-top categories-list-section">
    <div class="workspace-title-row">
      <div>
        <h2 class="workspace-title">
          Current categories
        </h2>
        <p class="workspace-note">
          Review category descriptions and assigned codes. Open a category to revise its details or manage its codes.
        </p>
      </div>
    </div>

    <div class="category-library-layout">

      <%= render partial: "memos/feed", locals: { memos: Memo.all.order(created_at: :desc), css_class: "category-library-memos", memo: Memo.new(kind: "researcher", referrent_id: @researcher.id) } %>

      <div class="category-library-shell">
        <div aria-label="Search, filter, and sort categories" class="category-library-toolbar search-toolbar" role="search">
          <div class="search-controls">
            <%= form_with model: Search.new(query: "", scope: "category"), data: {turbo: true} do |f| %>
              <label class="toolbar-field search-field"><span class="toolbar-label search-label">Search categories</span>
                  <%= f.text_field :query, class: "app-input search-input", type: "search", autocomplete: "on", placeholder: "Search codes", aria: { describedby: "site-search-feedback" } %>
                  <%= f.hidden_field :scope, value: "category" %>
              </label>
              <%= f.submit "Search", class: "site-search-submit" %>
            <% end %>
              
            <%= button_to "Clear search", searches_path, params: { search: { query: "*", scope: "category" } }, aria: { controls: "category-list" }, class: "button secondary small category-library-clear-search search-clear" %>
            
            <label class="toolbar-field search-sort"><span class="toolbar-label">Sort by</span>
              <select aria-controls="category-list" class="app-select" id="category-sort">
                <option value="name-asc">Name: A–Z</option>
                <option value="name-desc">Name: Z–A</option>
                <option value="codes-desc">Assigned codes: most to least</option>
                <option value="codes-asc">Assigned codes: least to most</option>
              </select>
            </label>
            <label class="category-library-checkbox search-filter"><input aria-controls="category-list" id="category-empty-filter" type="checkbox"/> Only categories with no assigned codes</label>
          </div>
          <p aria-live="polite" class="category-library-status search-result-count" id="category-library-status"><%= pluralize(@categories.count, "category") %></p>
        </div>
        <%= render partial: "categories/grid", locals: { categories: @categories } %>
      </div>
    </div>
  </section>
<% end %>
