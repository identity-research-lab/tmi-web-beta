<% code_count = category.codes.count %>
<article aria-labelledby="category-card-title" class="category-overview-card filterable" data-count="<%= code_count %>" data-name="<%= category.name %>">
  <div class="category-overview-card-content">
    <h3 class="category-overview-card-title">
      <%= category.name %>
    </h3>
    <p class="category-overview-card-memo">
      <%= category.description %>
    </p>
    <div class="category-workspace-footer">
      <span class="count-badge">
        <%= "#{code_count} code".pluralize(code_count) %> added
      </span>
    </div>
  </div>
  <div class="category-overview-card-actions">
    <%= link_to "Manage category", category_path(category), class: "button apply small", target: "_top" %>
  </div>
</article>
