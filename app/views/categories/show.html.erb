<%- title "Categories" %>
<%- active_nav "categories" %>

<section class="app-header app-header--detail">
  <div class="app-header-copy">
    <div class="app-label">
    <%= @project.name %> · <span class="app-label-dense">Category Development</span>
    </div>
    <h1 class="app-title"><%= @category.name %></h1>
    <p class="app-description">
      Review and revise this analytical category, manage its attached project codes, and document how the concept is developing across the data set.
    </p>
  </div>
  <aside aria-label="Relational analysis tools" class="app-header-panel category-relational-panel">
    <div class="app-panel-title">Relational analysis</div>
    <button class="button small secondary dashboard-template-button category-graph-button" type="button" disabled>
      Open category graph
    </button>
    <div class="case-subtext category-cypher-row confirmable">
      <span class="category-cypher-label">Cypher:</span>
      <a href="#" id="copy-source" class="cypher-link"><%= @category.graph_query[:query] %></a>
      <span id="confirmation" class="hidden">Copied!</span>
      <button id="copy-to-clipboard" class="copy-query-button" aria-label="Copy Cypher query" onclick="copyToClipboard('copy-source')" />
    </div>
  </aside>
</section>

<nav aria-label="Category workspace sections" class="category-page-links">
  <span class="category-page-links-label">On this page</span>
  <a href="#assigned-codes">Review assigned codes</a>
  <a href="#explore-codes">Explore and assign codes</a>
  <a href="#memos">Researcher memos</a>
</nav>

<!-- Category assignment workspace -->
<section class="category-detail-main">
  <div class="category-primary-layout">
  <section aria-labelledby="assigned-codes-title" class="category-work-area assigned-codes-area" id="assigned-codes">
    <div class="work-area-heading">
      <div>
        <h2 id="assigned-codes-title">Assigned codes</h2>
        <p>Review, search, sort, and remove codes currently assigned to this category.</p>
      </div>
    </div>
    <%= render partial: "categories/codes", locals: { category: @category, codes: @category_codes, attached_codes: @category_codes, pane: "attached" } %>
  </section>

  <%= render partial: "memos/feed", locals: { memo: @memo, memos: @memos, css_class: "category-detail-memos" } %>

  <section aria-labelledby="find-codes-title" class="category-work-area code-browser-area" id="explore-codes">
    <div class="work-area-heading browser-heading">
      <div>
        <h2 id="find-codes-title">Explore, find, and assign codes</h2>
        <p>Search the full project code collection and add relevant codes to this category.</p>
      </div>
    </div>
    <div aria-label="Search and filter all project codes" class="table-toolbar code-browser-controls search-toolbar" role="search">
      <%= form_with model: Search.new(query: "", scope: "theme"), data: {turbo: true} do |f| %>
        <label class="search-field browser-search"><span class="visually-hidden">Search all project codes</span>
          <%= f.text_field :query, id: "", class: "app-input search-input", type: "search", autocomplete: "on", placeholder: "Search code names" %>
          <%= f.hidden_field :scope, value: "code" %>
          <%= f.hidden_field :context, value: "category-details" %>
          <%= f.hidden_field :context_id, value: @category.id %>
          <%= f.hidden_field :limit, value: 50 %>
          <%= f.hidden_field :per_page, value: 5 %>
          <%= f.hidden_field :offset, value: 0 %>
        </label>
        <label class="toolbar-control category-library-checkbox search-filter"><input aria-controls="category-list" id="filter-attached" type="checkbox" />Not assigned to this category</label>
        <label class="toolbar-control category-library-checkbox search-filter"><input aria-controls="category-list" id="filter-high-freq" type="checkbox" checked />High frequency (15+)</label>
        <label class="toolbar-control category-library-checkbox search-filter"><input aria-controls="category-list" id="filter-low-freq" type="checkbox" checked/>Low frequency (1-7)</label>
        <button aria-controls="available-codes-table" class="button secondary small" id="clear-browser-filters" type="button">Clear search</button>
      <% end %>
    </div>
    <p class="visually-hidden" id="occurrences-help">Occurrences are the number of times a code has been applied across the project.</p>

    <%= render partial: "categories/codes", locals: { category: @category, codes: @codes, attached_codes: @category_codes, pane: "available" } %>

  </section>
  </div>
</section>
