<%- title "Categories" %>
<%- active_nav "categories" %>

<section class="app-header app-header--detail">
  <div class="app-header-copy">
    <div class="app-label">
    <%= @project.name %> · <span class="app-label-dense">Category Development</span>
    </div>
    <h1 class="app-title"><%= @category.name %></h1>
    <p class="app-description">
      Review and revise this analytical category, manage its attached project codes, and document how the concept is developing across the data set.
    </p>
  </div>
  <aside aria-label="Relational analysis tools" class="app-header-panel category-relational-panel">
    <div class="app-panel-title">Relational analysis</div>
    <button class="button small secondary dashboard-template-button category-graph-button" type="button" disabled>
      Open category graph
    </button>
    <div class="case-subtext category-cypher-row confirmable">
      <span class="category-cypher-label">Cypher:</span>
      <a href="#" id="copy-source" class="cypher-link"><%= @category.graph_query[:query] %></a>
      <span id="confirmation" class="hidden">Copied!</span>
      <button id="copy-to-clipboard" class="copy-query-button" aria-label="Copy Cypher query" onclick="copyToClipboard('copy-source')" />
    </div>
  </aside>
</section>

<nav aria-label="Category workspace sections" class="category-page-links">
  <span class="category-page-links-label">On this page</span>
  <a href="#assigned-codes">Review assigned codes</a>
  <a href="#explore-codes">Explore and assign codes</a>
  <a href="#memos">Researcher memos</a>
</nav>

<!-- Category assignment workspace -->
<section class="category-detail-main">
  <div class="category-primary-layout">
  <section aria-labelledby="assigned-codes-title" class="category-work-area assigned-codes-area" id="assigned-codes">
    <div class="work-area-heading">
      <div>
        <h2 id="assigned-codes-title">Assigned codes</h2>
        <p>Review, search, sort, and remove codes currently assigned to this category.<span class="work-area-instruction">Select a row once to mark the code for removal, then select it again to confirm.</span></p>
      </div>
      <span class="count-badge metric-count-badge"><span id="assigned-count"><%= @category_codes.count %></span> assigned codes</span>
    </div>

    <div aria-label="Search and filter assigned codes" class="table-toolbar assigned-toolbar search-toolbar" role="search">
      <label class="search-field">
        <span class="visually-hidden">Search assigned codes</span>
        <svg aria-hidden="true" viewbox="0 0 24 24"><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 4 4"></path></svg>
        <input aria-controls="assigned-codes-table" class="search-input" id="assigned-search" placeholder="Search assigned code names and origins" type="search"/>
      </label>
      <button aria-controls="assigned-codes-table" class="button secondary small search-clear" disabled id="clear-assigned-search" type="button">Clear search</button>
      <p aria-live="polite" class="search-result-count"><span id="assigned-visible-count"><%= @category_codes.count %></span> assigned codes</p>
    </div>

    <p aria-live="polite" class="assigned-status-feedback" id="assigned-feedback"><span class="browser-feedback-label">Code status change:</span> <span id="assigned-feedback-message">No changes yet.</span></p>
    <% if @category_codes.any? %>
      <div aria-label="Scrollable assigned codes table" class="data-table-window assigned-table-window" role="region" tabindex="0">
        <table class="code-data-table" id="assigned-codes-table">
          <caption class="visually-hidden">Codes currently assigned to this category</caption>
          <thead>
            <tr>
              <th scope="col"><button class="sort-button is-sorted" data-key="name" data-table="assigned-codes-table" type="button" >Code name <span aria-hidden="true">A–Z</span></button></th>
              <th scope="col"><button class="sort-button" data-key="frequency" data-table="assigned-codes-table" type="button">Occurrences <span aria-hidden="true">↕</span></button></th>
              <th scope="col">Code origins</th>
              <th scope="col"><span class="visually-hidden">Remove assignment</span></th>
            </tr>
          </thead>
          <tbody>
            <% @category_codes.each do |code| %>
              <tr class="" data-frequency="27" data-name="code switching and contextual self-presentation" data-origins="questions q03, q08; cases 9 personas; dimensions age, race/ethnicity, immigrant status, primary language">
                <td class="code-name-cell">
                  <span class="tag"><%= code.label %></span>
                </td>
                <td class="frequency-cell">27</td>
                <td class="origins-cell">
                  <div>Questions: <%= code.questions.map(&:identifier).to_sentence %></div>
                  <div>Cases: <%= pluralize(code.personas.count, "Persona") %></div>
                  <div>Dimensions: <%= code.dimensions.map(&:name).to_sentence %></div>
                </td>
                <td class="row-action-cell">
                  <button aria-label="Remove '<%= code.label %>' from this category" class="icon-button remove-code-button" title="Remove from category" type="button">
                    <svg aria-hidden="true" class="lucide lucide-trash2-icon lucide-trash-2" fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewbox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg">
                      <path d="M10 11v6"></path>
                      <path d="M14 11v6"></path>
                      <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"></path>
                      <path d="M3 6h18"></path>
                      <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                    </svg>
                  </button>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="empty-state search-empty-state" id="assigned-codes-empty"><strong>No matching assigned codes</strong><p>No assigned codes match the current search.</p><button aria-controls="assigned-codes-table" class="button secondary small" id="clear-assigned-search-filters" type="button">Clear search</button></div>
    <% end %>
  </section>

<section aria-labelledby="find-codes-title" class="category-work-area code-browser-area" id="explore-codes">
<div class="work-area-heading browser-heading">
<div>
<h2 id="find-codes-title">Explore, find, and assign codes</h2>
