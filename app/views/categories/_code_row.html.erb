<tr class="code-browser-row filterable" data-frequency="<%= code.frequency %>" data-name="<%= code.name %>" data-attached="<%= attached_codes.include?(code) %>">
  <td class="code-name-cell" data-sort-index="<%= code.name.downcase %>">
    <span class="tag"><%= code.name %></span>
  </td>
  <td class="frequency-cell" data-sort-index="<%= code.frequency.to_s.rjust(3, "0") %>"><%= code.frequency %></td>
  <td class="origins-cell">
    <div>Questions: <%= code.question_list.to_sentence %></div>
    <div>Cases: <%= code.persona_list.to_sentence %></div>
    <div>Dimensions: <%= code.dimension_list.to_sentence %></div>
  </td>
  <td class="row-action-cell">
    <%= form_with model: category, class: "assign-form", data: { turbo_stream: true } do |f| %>
      <%= f.hidden_field :code, value: code.id %>
      <% if pane == "attached" && attached_codes.include?(code) %>
        <%= f.button name: "remove", class: "icon-button remove-code-button", aria: { label: "Remove #{code.name} from this category" } do %>
          <svg aria-hidden="true" class="lucide lucide-trash2-icon lucide-trash-2" fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewbox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg">
            <path d="M10 11v6"></path>
            <path d="M14 11v6"></path>
            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"></path>
            <path d="M3 6h18"></path>
            <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
          </svg>
        <% end %>
      <% else %>
        <% show_check = attached_codes.include?(code) %>
        <%= image_tag "check-small.svg", data: { assignedid: code.id }, alt: "included in category", class: "icon-checkmark assigned-icon #{show_check ? '' : 'hidden'}" %></span>
        <%= f.button "+", name: "add", data: { assignedid: code.id }, class: "icon-button assign-button assign-code-button #{show_check ? 'hidden' : ''}", aria: { label: "Add #{code.name} to this category" } %>
      <% end %>
    <% end %>
  </td>
</tr>
