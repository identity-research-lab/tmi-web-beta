<%= turbo_frame_tag "category-codes-#{pane}" do %>

  <% if pane == "attached" %>
    <div aria-label="Scrollable assigned codes table" class="data-table-window assigned-table-window" role="region" tabindex="0">
      <table class="code-data-table" id="assigned-codes-table">
      <caption class="visually-hidden">Codes currently assigned to this category</caption>
  <% else %>
    <div aria-label="Scrollable assigned codes table" class="data-table-window assigned-table-window" role="region" tabindex="0">
      <table class="code-data-table" id="available-codes-table">
      <caption class="visually-hidden">Project codes available for category assignment</caption>
  <% end %>
        <thead>
          <tr>
            <th scope="col"><button class="sort-button is-sorted" data-key="name" data-table="assigned-codes-table" type="button" >Code name <span aria-hidden="true">A–Z</span></button></th>
            <th scope="col"><button class="sort-button" data-key="frequency" data-table="assigned-codes-table" type="button">Occurrences <span aria-hidden="true">↕</span></button></th>
            <th scope="col">Code origins</th>
            <th scope="col"><span class="visually-hidden">Remove assignment</span></th>
          </tr>
        </thead>
        <tbody>
          <% codes.each do |code| %>
            <%= render partial: "categories/code_row", locals: { category: category, code: code, attached_codes: attached_codes, pane: pane } %>
          <% end %>
        </tbody>
      </table>
    </div>
    <% if pane == "attached" %>
      <p aria-live="polite" class="search-result-count">
        <%= attached_codes.count %> assigned project codes
      </p>
    <% else %>
      <p aria-live="polite" class="search-result-count">
        <span id="available-visible-count"></span><span id="available-total-count"><%= codes.count %></span> project codes
      </p>
    <% end %>

  <script>fireFilters();</script>    
<% end %>
