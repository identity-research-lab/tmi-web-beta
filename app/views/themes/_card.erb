<article aria-labelledby="category-card-title-1" class="category-overview-card" data-code-count="23" data-name="Belonging and affinity">
  <div class="category-overview-card-content">
    <h3 class="category-overview-card-title">
      <%= category.name %>
    </h3>
    <p class="category-overview-card-memo">
      <%= category.description %>
    </p>
    <div class="category-workspace-footer">
      <span class="count-badge">
        <%= "#{category.codes.count} code".pluralize(category.codes.count) %> added
      </span>
    </div>
  </div>
  <div class="category-overview-card-actions">
    <%= link_to "Manage category", category_path(category), class: "button apply small" %>
  </div>
</article>
