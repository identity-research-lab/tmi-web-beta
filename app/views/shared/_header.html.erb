<header class="top-header">
	<div class="brand">
		<a href="/" class="logo" aria-label="TMI-WEB home">
			<%= image_tag "tmi-logo.svg", alt: "TMI-WEB", class: "logo-image" %>
		</a>
		<div class="tagline">
			Real people.<br>
			Complex identities.<br>
			Situated experiences.<br>
			<span class="tagline-emphasis">Intersectional Data Analysis</span>
		</div>
	</div>

  <nav class="top-nav" id="top-nav" aria-label="Utility navigation">
    <label class="visually-hidden" for="site-search-input">Search TMI-WEB</label>

    <div class="site-search-control">
      <%= form_with model: Search.new(""), data: {turbo: false} do |f| %>
        <%= f.text_field :query, class: "site-search-input", type: "search", autocomplete: "off", placeholder: "Search TMI-WEB", aria: { describedby: "site-search-feedback" } %>
        <%= f.submit "Search", class: "site-search-submit" %>
      <% end %>
    </div>
    <%= link_to "TMI-WEB instructional guides", "#", class: "button", target: "_blank", rel: "noopener noreferrer" %>
  </nav>

	<button class="mobile-menu" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="top-nav">☰</button>
</header>

<nav class="mobile-nav hidden">
	<a href="#" class="button">TMI-WEB Instructional Guides</a>
	<ul>
		<li><div class="mobile-divider"></div></li>
		<li><div class="mobile-project-label">Active Project:</div></li>
		<li><%= link_to "Dashboard", project_path(@project) %></li>
		<li><%= link_to "Cases", personas_path %></li>
		<li><%= link_to "Survey Items", survey_items_path %></li>
		<li><a href="#">Code Metrics</a></li>
		<li><a href="#">Codes</a></li>
		<li><a href="#">Categories</a></li>
		<li><a href="#">Themes</a></li>
    <li><%= link_to "Journal", journal_path(Journal.new) %></li>
		<li><a href="#">Graph</a></li>
	</ul>
</nav>

<nav class="content-nav" aria-label="Active project navigation">
  <% active_nav = content_for?(:active_nav) && content_for(:active_nav) %>
	<div class="tabs">
    <div class="nav-group" role="group" aria-label="Project">
      <%= link_to "Dashboard", project_path(@project), class: active_nav == "dashboard" ? 'active-nav' : '' %>
      <%= link_to "Manage Project Data", edit_project_path(@project), class: active_nav == "dashboard" ? 'active-nav' : '' %>
    </div>
    <div class="nav-group" role="group" aria-label="Coding pathways">
      <%= link_to "Code Individual Cases", personas_path, class: active_nav == "cases" ? 'active-nav' : '' %>
      <%= link_to "Code Responses by Question", survey_items_path, class: active_nav == "survey_items" ? 'active-nav' : '' %>
    </div>
    <div class="nav-group" role="group" aria-label="Analysis">
      <a href="11code-metrics.html">Codes</a>
      <a href="12categories.html">Categories</a>
      <a href="14themes.html">Themes</a>
    </div>
  </div>
</nav>
