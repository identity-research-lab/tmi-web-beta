<%= turbo_frame_tag "category-codes-#{pane}" do %>

  <% table_id = pane == "attached" ? "assigned-codes-table" : "available-codes-table" %>
  <% if pane == "attached" %>
    <div aria-label="Scrollable assigned codes table" class="data-table-window assigned-table-window" role="region" tabindex="0">
      <table class="code-data-table" id="<%= table_id %>">
      <caption class="visually-hidden">Codes currently assigned to this category</caption>
  <% else %>
    <div aria-label="Scrollable assigned codes table" class="data-table-window assigned-table-window" role="region" tabindex="0">
      <table class="code-data-table" id="<%= table_id %>">
      <caption class="visually-hidden">Project codes available for category assignment</caption>
  <% end %>
  
  <% if codes.any? %>
    <% sort_class = pane == "attached" ? "sort-button" : "sort-button search-sort-button" %>
        <thead>
          <tr>
            <th scope="col" class="sortable" data-sort-direction="desc">
              <span class="sort-header">
                <button class="<%= sort_class %>" data-key="name" type="button">Code name <span aria-hidden="true">A–Z</span></button>
              </span>
            </th>
            <th scope="col" class="sortable" data-sort-direction="desc">
              <span class="sort-header">
                <button class="<%= sort_class %>" data-key="frequency" type="button">Occurrences <span aria-hidden="true">↕</span></button>
              </span>
            </th>
            <th scope="col">Code origins</th>
            <th scope="col"><span class="visually-hidden">Remove assignment</span></th>
          </tr>
        </thead>
        <tbody>
          <% codes.each do |code| %>
            <%= render partial: "categories/code_row", locals: { category: category, code: code, attached_codes: attached_codes, pane: pane } %>
          <% end %>
        </tbody>
      <% end %>
    </table>
  </div>
  
  <% if pane == "attached" %>
    <p aria-live="polite" class="search-result-count">
      <%= attached_codes.count %> assigned project codes
    </p>
  <% else %>
    <div style="margin-top: 2rem; text-align: center; width: 100%;">
      <button class="button small page-button" id="page-back" data-direction="back" style="float: left;">Previous</button>
      <button class="button small page-button" id="page-next" data-direction="next" style="float: right;">Next</button>
    </div>
    <p aria-live="polite" class="search-result-count">
      <% total ||= codes.count %>
      <% if pane == "available" %>
        <span id="available-window"></span> of
      <% end %>
      <span id="available-visible-count"></span><span id="available-total-count"><%= total %></span>
    </p>
  <% end %>

  <script>fireFilters();handleSearchSort();handleSearchPagination();</script>
<% end %>
