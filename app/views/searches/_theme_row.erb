<article class="excerpt-card">
  <div class="excerpt-meta">
    <span class="case-subtext"><%= link_to theme.name, theme, target: "_top" %></span>
  </div>
  <p class="excerpt-text">
    <%= theme.description %>
  </p>
  <div class="tag"><span class="search-result"><%= theme.categories.count %> categories</span></div>
</article>
