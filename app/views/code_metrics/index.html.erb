<%- title "Code Metrics" %>
<%- active_nav "code_metrics" %>

<section class="app-header dashboard-hero">
  <div class="app-header-copy">
    <div class="app-label">
      <%= @project.name %> · <span class="app-label-dense">Pathways</span> · <span class="app-label-dense">Coding by Question</span>
    </div>
    <h1 class="app-title">Code Metrics</h1>
    <p class="app-description">
      Review coding patterns through either the question/response pathway or the individual case pathway while preserving the context in which codes were applied.    </p>
  </div>
</section>

<% if @project.active_fields.count == 0 %>
  <section class="coding-readiness-gate" data-coding-readiness-states="setup">
    <div class="app-label">Project readiness</div>
    <h2 class="workspace-title">Project data setup required</h2>
    <p class="workspace-note">Add project data and confirm the analysis schema before reviewing code metrics.</p>
    <%= link_to "Manage project data", edit_project_path(@project), class: "button apply" %>
  </section>
<% elsif @survey_items.any? %>
  <aside class="app-header-panel metrics-context-panel" aria-label="Responses by question metrics overview" data-metrics-states="question">
    <h2 class="app-panel-title">
      Responses by question view
    </h2>
    <p class="workspace-note">
      Select a question to compare code occurrences across participant responses. Counts support review and navigation; they do not determine interpretive significance.
    </p>
  </aside>
  
  <aside class="app-header-panel metrics-context-panel" aria-label="Individual case metrics overview" data-metrics-states="case">
    <h2 class="app-panel-title">Individual case view</h2>
    <p class="workspace-note">
      Select one case to review code occurrences across that participant’s responses while retaining question and response context.
    </p>
  </aside>

  <%= render partial: "persona", locals: { persona: nil, personas: @personas } %>
  <%= render partial: "question", locals: { survey_item: nil, survey_items: @survey_items } %>

<% end %>
