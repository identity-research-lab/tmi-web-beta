<%= turbo_frame_tag "memo-feed" do %>
  <section id="memos" class="sidebar-card white researcher-memos <%= css_class %>">
    <h2 class="sidebar-card-title">Researcher memos</h2>
    <% if memos.present? %>
      <% memos.each do |existing_memo| %>
        <%= render partial: "memos/show", locals: { memo: existing_memo } %>
      <% end %>
    <% else %>
      <div class="memo-entry">
        <p class="memo-text">
          No recent memos.
        </p>
      </div>
    <% end %>
    <% if memo.present? %>
      <%= render partial: "/memos/form", locals: { memo: memo } %>
    <% end %>
  </section>
<% end %>